MlWorkflow {
  tasks = [
    MlTask {
      taskId = prep
      type   = PREPARE
      params = [ Param { key = "normalize" value = "true" }, Param { key = "resize" value = "28x28" } ]
      produces = [ Artifact { path = "artifacts/processed.parquet" kind = DATASET } ]
    },
    MlTask {
      taskId = train
      type   = TRAIN
      consumes = [ Artifact { path = "artifacts/processed.parquet" kind = DATASET } ]
      produces = [
        Artifact { path = "artifacts/model.pt"   kind = MODEL },
        Artifact { path = "artifacts/metrics.json" kind = METRICS }
      ]
    },
    MlTask {
      taskId = eval
      type   = EVAL
      consumes = [ Artifact { path = "artifacts/model.pt" kind = MODEL } ]
      produces = [ Artifact { path = "artifacts/eval.json" kind = METRICS } ]
    },
    MlTask {
      taskId = serve
      type   = SERVE
      consumes = [ Artifact { path = "artifacts/model.pt" kind = MODEL } ]
      produces = [ Artifact { path = "docker/image.tar" kind = IMAGE } ]
    }
  ]

  edges = [
    Edge { from = prep  to = train },
    Edge { from = train to = eval  },
    Edge { from = train to = serve }
  ]
}
