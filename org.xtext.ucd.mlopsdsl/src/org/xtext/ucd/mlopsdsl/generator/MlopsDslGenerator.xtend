import org.eclipse.emf.ecore.resource.Resource
import org.eclipse.xtext.generator.AbstractGenerator
import org.eclipse.xtext.generator.IFileSystemAccess2
import org.eclipse.xtext.generator.IGeneratorContext
import org.apache.log4j.Logger

/**
 * Génère les artefacts MLOps à chaque sauvegarde d'un fichier .mlopstxt.
 * Cette classe Xtend délègue au générateur Java MlopsGenerator.
 */
class MlopsDslGenerator extends AbstractGenerator {

    static val LOG = Logger.getLogger(MlopsDslGenerator)

    override void doGenerate(Resource resource, IFileSystemAccess2 fsa, IGeneratorContext context) {
        try {

            val gen = new MlopsGenerator
            gen.doGenerate(resource, fsa, context)


            fsa.generateFile(
                'generated/.mlopsdsl.ok',
                '''OK: «resource.URI.lastSegment» → artefacts générés'''
            )

        } catch (Exception e) {
